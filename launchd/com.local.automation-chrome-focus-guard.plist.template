<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.local.automation-chrome-focus-guard</string>

  <!--
    CDP focus-guard proxy. Listens on the public automation port (9333) and
    forwards to the dedicated Chrome on its internal port (9335), stripping the
    commands that would pull macOS focus to Chrome (Target.createTarget in the
    foreground, Page.bringToFront, Target.activateTarget). mcp.json and every
    workflow keep pointing at 9333; Chrome never comes to the front on its own.

    __HOME__ and __NODE__ are substituted by install.sh. Do not edit this file
    in place; edit the template and re-run the installer.

    Managed with:
      launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.local.automation-chrome-focus-guard.plist
      launchctl bootout   gui/$(id -u)/com.local.automation-chrome-focus-guard
      launchctl kickstart -k gui/$(id -u)/com.local.automation-chrome-focus-guard
  -->

  <key>ProgramArguments</key>
  <array>
    <string>__NODE__</string>
    <string>__HOME__/.cursor/mcp-wrappers/focus-guard.mjs</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>FOCUS_GUARD_LISTEN_PORT</key>
    <string>9333</string>
    <key>FOCUS_GUARD_CHROME_PORT</key>
    <string>9335</string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>

  <!-- Always keep the proxy up; it is the stable endpoint everything uses. -->
  <key>KeepAlive</key>
  <true/>

  <!-- Throttle launches so a crash-loop doesn't burn CPU. -->
  <key>ThrottleInterval</key>
  <integer>10</integer>

  <key>StandardOutPath</key>
  <string>__HOME__/.cursor/mcp-wrappers/focus-guard.launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/.cursor/mcp-wrappers/focus-guard.launchd.err.log</string>
</dict>
</plist>
