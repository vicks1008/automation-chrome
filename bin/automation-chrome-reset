#!/bin/bash
# Restart the automation Chrome via launchd (never from a shell).
uid=$(id -u)
launchctl kickstart -k "gui/$uid/com.local.automation-chrome" 2>&1 || \
  launchctl bootstrap "gui/$uid" "$HOME/Library/LaunchAgents/com.local.automation-chrome.plist"
for _ in $(seq 1 30); do
  curl -s --max-time 1 http://127.0.0.1:9335/json/version >/dev/null 2>&1 && break
  sleep 1
done
"$HOME/.local/bin/automation-chrome-health"
