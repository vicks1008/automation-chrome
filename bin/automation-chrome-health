#!/bin/bash
# Reports whether Chrome (9335) and the focus guard (9333) are answering.
rc=0
if curl -s --max-time 3 http://127.0.0.1:9335/json/version >/dev/null 2>&1; then
  echo "chrome (9335): ok"
else
  echo "chrome (9335): DOWN"; rc=1
fi
if curl -s --max-time 3 http://127.0.0.1:9333/json/version | grep -q webSocketDebuggerUrl; then
  echo "guard  (9333): ok"
else
  echo "guard  (9333): DOWN or upstream error"; rc=1
fi
# Tab hygiene: many open pages usually means sessions are leaking tabs.
# Informational only; nothing is closed automatically.
pages=$(curl -s --max-time 3 http://127.0.0.1:9333/json/list | grep -c '"type": "page"')
if [ "${pages:-0}" -gt 15 ]; then
  echo "tabs         : $pages open (more than 15; sessions may be leaking tabs, close the ones you own by pageId)"
else
  echo "tabs         : ${pages:-0} open"
fi
idle=$(curl -s --max-time 3 http://127.0.0.1:9333/focus-guard/health | sed -n 's/.*"idleSeconds":\([0-9]*\).*/\1/p')
[ -n "$idle" ] && echo "agent idle   : ${idle}s since last command"
exit $rc
