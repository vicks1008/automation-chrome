#!/bin/bash
# Reports whether Chrome (9335) and the focus guard (9333) are answering.
rc=0
if curl -s --max-time 3 http://127.0.0.1:9335/json/version >/dev/null 2>&1; then
  echo "chrome (9335): ok"
else
  echo "chrome (9335): DOWN"; rc=1
fi
if curl -s --max-time 3 http://127.0.0.1:9333/json/version | grep -q webSocketDebuggerUrl; then
  echo "guard  (9333): ok"
else
  echo "guard  (9333): DOWN or upstream error"; rc=1
fi
exit $rc
