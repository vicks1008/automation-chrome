#!/bin/bash
# Launches the dedicated CursorAutomation Chrome on internal CDP port 9335.
# The focus-guard proxy (launchd: com.local.automation-chrome-focus-guard) serves 9333 -> 9335.
# Under launchd (AUTOMATION_CHROME_FOREGROUND=1) Chrome is exec'd so launchd owns it.
# Rebuilt 2026-10-08 after the original script was found blanked (1 byte).
PORT="${AUTOMATION_CHROME_PORT:-9335}"
PROFILE="$HOME/Library/Application Support/Google/Chrome/CursorAutomation"
CHROME="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"

if curl -s --max-time 2 "http://127.0.0.1:$PORT/json/version" >/dev/null 2>&1; then
  echo "[automation-chrome] already listening on port $PORT"
  exit 0
fi

ARGS=(
  --remote-debugging-port="$PORT"
  --remote-allow-origins='*'
  --user-data-dir="$PROFILE"
  --no-first-run
  --no-default-browser-check
  --disable-backgrounding-occluded-windows
  --disable-renderer-backgrounding
  --disable-background-timer-throttling
)

if [ "${AUTOMATION_CHROME_FOREGROUND:-}" = "1" ]; then
  echo "[automation-chrome] foreground exec on port $PORT"
  exec "$CHROME" "${ARGS[@]}"
fi

"$CHROME" "${ARGS[@]}" >/dev/null 2>&1 &
disown
for _ in $(seq 1 30); do
  curl -s --max-time 1 "http://127.0.0.1:$PORT/json/version" >/dev/null 2>&1 && { echo "[automation-chrome] ready on port $PORT"; exit 0; }
  sleep 0.5
done
echo "[automation-chrome] failed to start on port $PORT" >&2
exit 1
